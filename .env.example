# ============================================
# OAuth Configuration — Killtime Codex
# Copie ce fichier en ".env" et remplis les valeurs
# ============================================

# Google OAuth 2.0
# Obtenu depuis: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL publique (ton URL ngrok ou domaine)
# C'est l'URL que Google utilisera pour le callback
OAUTH_CALLBACK_BASE=https://unsaddle-computer-profile.ngrok-free.dev
